{
  "name": "tmail-cli",
  "version": "0.1.0-alpha.1",
  "description": "An agent-friendly terminal email client.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tmail": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "demo": "node --env-file=.env.demo dist/cli.js",
    "dev": "tsx src/cli.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:pty": "npm run build && TMAIL_PTY_TEST=1 vitest run test/pty.test.ts",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "commander": "15.0.0",
    "ink": "7.1.1",
    "react": "19.2.8",
    "rehype-parse": "9.0.1",
    "rehype-remark": "10.0.1",
    "rehype-sanitize": "6.0.0",
    "remark-stringify": "11.0.0",
    "string-width": "8.2.2",
    "unified": "11.0.5",
    "zod": "4.4.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "1.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/mdast": "4.0.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "ink-testing-library": "4.0.0",
    "node-pty": "1.1.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
